{
  "permissions": {
    "allow": ["Read", "Grep", "Glob", "Bash(npm test)", "Bash(npm test *)", "PowerShell(npm test)", "PowerShell(npm test *)"],
    "ask": ["Bash(git push *)", "PowerShell(git push *)"],
    "deny": ["Read(./.env)", "Bash(rm -rf *)", "PowerShell(Remove-Item *)"]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "f=$(jq -r '.tool_input.file_path') && npx prettier --write \"$f\"" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/bloquear-peligrosos.sh" }
        ]
      }
    ]
  }
}
